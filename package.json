{
  "name": "idun",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:pages": "tsc --noEmit && vite build web --config web/vite.showcase.config.mjs && node scripts/prepare-pages.cjs",
    "build": "npm run build:pages",
    "start": "npm run build:pages && vite preview web --config web/vite.showcase.config.mjs --host 127.0.0.1",
    "preview": "vite preview web --config web/vite.showcase.config.mjs --host 127.0.0.1",
    "test:workspace": "node scripts/verify-static-runtime.mjs",
    "test:browser": "node scripts/verify-public-workspace.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "cytoscape": "3.33.1",
    "papaparse": "^5.7.0",
    "pyodide": "314.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
